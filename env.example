# ─── Copie para .env e preencha. NUNCA commite o .env. ─────────────────────────

# BytePlus ModelArk (Seedance / Seedream) — região ap-southeast-1
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Modelos ativos na conta (ajuste quando ativar Seedance 2.5 etc.)
ARK_VIDEO_MODEL=seedance-1-0-pro-250528           # texto→vídeo e imagem→vídeo
ARK_VIDEO_MODEL_FAST=seedance-1-0-pro-fast-251015 # imagem→vídeo (mais barato)
ARK_IMAGE_MODEL=seedream-4-5-251128               # confira o Model ID no console
ARK_TEXT_MODEL=dola-seed-2-1-turbo-260628         # roteiro automático (500K tokens grátis)

# Seed Speech (voz / clonagem) — mesma conta BytePlus. Vazio = usa ARK_API_KEY
SEED_SPEECH_API_KEY=
SEED_SPEECH_BASE_URL=https://voice.ap-southeast-1.bytepluses.com/api/v3

# Seedance 2.5 / 2.0 — só depois de pagar os US$ 30 de fundo de reserva no console
ARK_ALLOW_SEEDANCE_2=false

# fal.ai (MiniMax H3, Kling, GPT Image, Nano Banana…) — conta em fal.ai/dashboard/keys; pré-pago, mínimo US$ 10
FAL_KEY=

# Seedance 1.5 pro: a BytePlus parou de ativar ("stopping new purchases"); só ligue se o console voltar a permitir
ARK_ALLOW_SEEDANCE_15=false

# Google AI Studio (Nano Banana / Veo) — fase 2, opcional
GOOGLE_API_KEY=

# ElevenLabs (voz) — fase 3, opcional
# ElevenLabs (narração v4, clonar voz, efeitos sonoros) — plano Starter US$ 5/mês libera clonagem
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
# voz padrão (id de uma voz da sua biblioteca ElevenLabs); vazio = "George"
ELEVENLABS_VOICE_ID=

# Infra local
DATABASE_URL=postgres://g2:g2@localhost:5433/g2studio
REDIS_URL=redis://localhost:6380

# Guarda de custo: a API recusa jobs acima disso (USD) sem flag allowPaid
MAX_JOB_COST_USD=0.50
# trava de narração: não gera voz além disso (Seed Speech dá 60 min grátis, depois US$ 0,15/min)
VOICE_FREE_MINUTES=55

# ── Cortes / legenda automática (Whisper local no Docker, grátis) ──
# modelo: small (padrão, rápido) · medium · large-v3-turbo (melhor em português, ~3x mais lento)
WHISPER_MODEL=small
WHISPER_URL=http://localhost:9000
WHISPER_LANGUAGE=pt

# ── Publicar direto (configuração, não custo) ──
# token de usuário do sistema do Meta com instagram_content_publish (+ ads_management pro Meta Ads)
META_ACCESS_TOKEN=
IG_USER_ID=
META_AD_ACCOUNT_ID=act_
# YouTube Shorts: OAuth do seu canal (Google Cloud → credencial "Aplicativo da Web", URI de redirecionamento
# http://localhost:4000/v1/publish/youtube/callback). Depois: Provedores → Publicar → "Conectar YouTube" (uma vez).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# se a API não estiver em localhost:4000, o endereço público dela (pro callback do YouTube)
# PUBLIC_API_URL=http://localhost:4000

# ── Login da equipe (deixe false no Mac; true quando o app estiver na nuvem) ──
AUTH_REQUIRED=false
# primeiro admin: criado sozinho no primeiro boot se ainda não existir ninguém
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
# token de máquina (MCP/automação): o MCP manda como G2_API_TOKEN
API_TOKEN=
SESSION_DAYS=30

# ── Arquivos num bucket (nuvem). Sem isso, tudo fica na pasta storage/ do computador ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# true pra MinIO e alguns S3 compatíveis
S3_FORCE_PATH_STYLE=false
# quanto do disco usar como cache antes de limpar os mais antigos (que já estão no bucket)
STORAGE_CACHE_GB=3

# ── Custo zero (padrão). Com true o app recusa tudo que cobraria no cartão (fal, ElevenLabs, GPU, Seedance 2.x)
# e a voz para nos 60 min grátis. Só mude pra false depois de aprovar o gasto.
ZERO_COST=true

# ── GPU própria (Modal, serverless) — EXPERIMENTAL, pago por segundo de GPU. Deixe vazio pra não usar.
# Wan 2.2: infra/gpu/g2_video.py ("Ligar GPU.command" preenche URL e TOKEN)
G2_GPU_URL=
G2_GPU_TOKEN=
# vazio = padrão do código: US$ 4,10/h (H100 + CPU/RAM no Modal)
G2_GPU_USD_PER_HOUR=
G2_GPU_SEC_720=
G2_GPU_SEC_480=
# MiniMax H3 em 4× H100: infra/gpu/g2_h3.py ("Ligar H3.command")
G2_GPU_H3_URL=
# vazio = padrão do código: US$ 17,80/h (4× H100 + CPU/RAM no Modal)
G2_GPU_H3_USD_PER_HOUR=
G2_GPU_H3_SEC=

# quantas gerações o worker roda ao mesmo tempo
GENERATION_CONCURRENCY=8
