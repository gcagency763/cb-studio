+"use client";
+
+import { useEffect, useMemo, useState } from "react";
+import { ApiError, api, usd, type Job, type Voice } from "@/lib/api";
+import { toOption, useModels, type CatalogModel } from "@/lib/models";
+import { History, ModelCard, ReferencePicker } from "@/components/create";
+import { useConfirm, useToast } from "@/components/Toasts";
+
+/**
+ * Clone: pessoa real falando sem gravar.
+ *  1) foto da pessoa + narração (voz clonada) → vídeo falando (OmniHuman / Kling Avatar / Seedance 2.5)
+ *  2) vídeo pronto + áudio → arruma a boca (Sync Lipsync)
+ */
+export default function ClonePage() {
+  const toast = useToast();
+  const ask = useConfirm();
+  const [tab, setTab] = useState<"avatar" | "lipsync">("avatar");
+  const avatars = useModels("avatar");
+  const lipsyncs = useModels("lipsync");
+  const videoModels = useModels("video");
+  // Seedance 2.5 também "clona": aceita áudio de referência
+  const options = useMemo(() => [...avatars, ...videoModels.filter((m) => m.audioRef)], [avatars, videoModels]);
+  const [modelId, setModelId] = useState("omnihuman-1.5");
+  const model: CatalogModel | undefined = options.find((m) => m.id === modelId) ?? options[0];
+
+  const [photo, setPhoto] = useState<string | null>(null);
+  const [audio, setAudio] = useState<string | null>(null);
+  const [video, setVideo] = useState<string | null>(null);
+  const [prompt, setPrompt] = useState("");
+  const [res, setRes] = useState<"720p" | "1080p">("1080p");
+  const [audioSec, setAudioSec] = useState(10);
+  const [pro, setPro] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [tick, setTick] = useState(0);
+  const [voices, setVoices] = useState<Voice[]>([]);
+  useEffect(() => {
+    api<{ voices: Voice[] }>("/voices").then((r) => setVoices(r.voices)).catch(() => {});
+  }, []);
+
+  // mede a duração do áudio escolhido (pra estimar custo)
+  useEffect(() => {
+    if (!audio) return;
+    const a = new Audio(audio);
+    a.addEventListener("loadedmetadata", () => Number.isFinite(a.duration) && setAudioSec(Math.ceil(a.duration)));
+  }, [audio]);
+
+  const lip = lipsyncs[0];
+  const request = () =>
+    tab === "avatar"
+      ? { kind: "avatar", model: model?.id, imageUrl: photo!, audioUrl: audio!, prompt: prompt || undefined, resolution: res, audioSec }
+      : { kind: "lipsync", model: lip?.id, videoUrl: video!, audioUrl: audio!, pro, videoSec: audioSec };
+
+  const generate = async () => {
+    if (!audio) return toast("Escolha o áudio (narração) primeiro — gere em Áudio com a voz clonada", "bad");
+    if (tab === "avatar" && !photo) return toast("Escolha a foto da pessoa", "bad");
+    if (tab === "lipsync" && !video) return toast("Escolha o vídeo que vai receber a boca", "bad");
+    const m = tab === "avatar" ? model : lip;
+    if (!m) return;
+    if (m.locked) return toast(m.locked, "bad");
+    setBusy(true);
+    try {
+      const { estimatedCostUsd } = await api<{ estimatedCostUsd: number }>("/estimate", { method: "POST", body: JSON.stringify({ request: request() }) });
+      const paid = m.provider === "fal" || m.gate === "reserve";
+      if (!await ask(`${tab === "avatar" ? "Gerar a pessoa falando" : "Sincronizar a boca"} com ${m.name} (~${audioSec}s)?\nCusto ${usd(estimatedCostUsd)} — ${paid ? "COBRADO no cartão" : "sai da cota grátis"}.\n\nLembrete: só com autorização da pessoa.`, paid ? "Gerar e cobrar" : "Gerar")) return;
+      await api<Job>("/generate", { method: "POST", body: JSON.stringify({ request: request(), allowPaid: paid }) });
+      setTick((t) => t + 1);
+      toast("Na fila — leva 1 a 4 minutos");
+    } catch (e: any) {
+      if (e instanceof ApiError && e.status === 402) toast(`Guarda de custo: ${usd(e.body.estimatedCostUsd)} acima do limite ${usd(e.body.maxJobCostUsd)}`, "bad");
+      else toast(e.message, "bad");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className="create">
+      <aside className="panel" aria-label="Clone">
+        <div className="panel-tabs">
+          <button className={`panel-tab ${tab === "avatar" ? "active" : ""}`} onClick={() => setTab("avatar")}>
+            Foto + voz → falando
+          </button>
+          <button className={`panel-tab ${tab === "lipsync" ? "active" : ""}`} onClick={() => setTab("lipsync")}>
+            Arrumar a boca
+          </button>
+        </div>
+
+        {tab === "avatar" ? (
+          <>
+            {model && <ModelCard model={toOption(model)} options={options.map(toOption)} onChange={(m) => setModelId(m.id)} />}
+            {model?.locked && <div className="empty" style={{ padding: 10 }}>{model.locked}</div>}
+            <ReferencePicker kind="image" label="Foto da pessoa" value={photo} onChange={setPhoto} hint="rosto de frente, bem iluminado, sem óculos escuros (pode ser uma imagem gerada com Nano Banana 2.1 + referências)" />
+          </>
+        ) : (
+          <>
+            {lip && <ModelCard model={toOption(lip)} options={lipsyncs.map(toOption)} onChange={() => {}} />}
+            {lip?.locked && <div className="empty" style={{ padding: 10 }}>{lip.locked}</div>}
+            <ReferencePicker kind="video" label="Vídeo pronto" value={video} onChange={setVideo} accept="video/*" hint="o vídeo onde a boca vai ser refeita" />
+          </>
+        )}
+
+        <ReferencePicker kind="audio" label="Narração (voz clonada)" value={audio} onChange={setAudio} accept="audio/*" hint={`gere em Áudio → Texto → fala com a voz da pessoa${voices.length ? ` (${voices.length} voz(es) cadastrada(s))` : ""}`} />
+
+        {tab === "avatar" ? (
+          <>
