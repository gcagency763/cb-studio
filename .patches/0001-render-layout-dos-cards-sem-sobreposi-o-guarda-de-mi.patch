diff --git a/apps/api/src/lib/db.ts b/apps/api/src/lib/db.ts
index fb766cf..2fc71e3 100644
--- a/apps/api/src/lib/db.ts
+++ b/apps/api/src/lib/db.ts
@@ -226,3 +226,11 @@ export async function listAssets(kind?: string, limit = 200) {
     ? sql<JobRow[]>`select * from jobs where status = 'succeeded' and output_url is not null and kind = ${kind} order by created_at desc limit ${limit}`
     : sql<JobRow[]>`select * from jobs where status = 'succeeded' and output_url is not null order by created_at desc limit ${limit}`;
 }
+
+/** minutos de áudio já gerados pelo Seed Speech (sucesso) — pra guarda da cota grátis */
+export async function voiceMinutesUsed(): Promise<number> {
+  const [row] = await sql<{ secs: string | null }[]>`
+    select coalesce(sum((usage->>'seconds')::numeric), 0) as secs
+    from jobs where kind = 'audio' and status = 'succeeded'`;
+  return Number(row?.secs ?? 0) / 60;
+}
