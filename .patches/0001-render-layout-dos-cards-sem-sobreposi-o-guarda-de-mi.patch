+          voiceMinutesUsed: used,
+          voiceFreeMinutes: env.VOICE_FREE_MINUTES,
+        });
+      }
+    }
     // ── GUARDA DE CUSTO ──────────────────────────────────────────────
     if (cost > env.MAX_JOB_COST_USD && !body.allowPaid) {
       return reply.code(402).send({
