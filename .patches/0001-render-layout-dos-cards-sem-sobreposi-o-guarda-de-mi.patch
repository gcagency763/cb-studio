@@ -39,3 +39,5 @@ S3_PUBLIC_BASE_URL=
 
 # Guarda de custo: a API recusa jobs acima disso (USD) sem flag allowPaid
 MAX_JOB_COST_USD=0.50
+# trava de narração: não gera voz além disso (Seed Speech dá 60 min grátis, depois US$ 0,15/min)
