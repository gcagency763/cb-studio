{
  "name": "cb-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Estúdio de vídeo IA da G2 Educação — storyboard → imagem → vídeo → render",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @g2/db run migrate",
    "smoke:byteplus": "bash scripts/smoke-byteplus.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
